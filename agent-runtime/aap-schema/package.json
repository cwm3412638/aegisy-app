{
  "name": "@aegisy/aap-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned Aegisy Agent Protocol wire schemas and fixtures",
  "license": "UNLICENSED",
  "scripts": {
    "generate": "node scripts/generate-core-types.mjs",
    "generate:check": "node scripts/generate-core-types.mjs --check",
    "test:generator": "node scripts/test-core-generator-inputs.mjs"
  },
  "files": [
    "README.md",
    "stable",
    "experimental",
    "fixtures",
    "generated",
    "scripts"
  ],
  "aegisy": {
    "schema_version": "aap-schema-package/0.1",
    "namespaces": [
      {
        "name": "stable",
        "registry": "stable/namespace.json"
      },
      {
        "name": "experimental",
        "registry": "experimental/namespace.json"
      }
    ]
  }
}
