        },
        "total_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "total_canonical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "after": {
          "oneOf": [
            { "$ref": "#/$defs/timelineSnapshotCursor" },
            { "type": "null" }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/timelineSnapshotItem" }
        },
        "next_after": {
          "oneOf": [
            { "$ref": "#/$defs/timelineSnapshotCursor" },
            { "type": "null" }
          ]
        },
        "complete": { "type": "boolean" },
        "page_identity": { "$ref": "#/$defs/timelineSnapshotPageId" }
      },
      "oneOf": [
        {
          "properties": {
            "complete": { "const": true },
            "next_after": { "type": "null" }
          }
        },
        {
          "properties": {
            "complete": { "const": false },
            "items": { "minItems": 1 },
            "next_after": { "$ref": "#/$defs/timelineSnapshotCursor" }
          }
        }
      ]
