          "oneOf": [
            { "$ref": "#/$defs/timelineSnapshotId" },
            { "type": "null" }
          ]
        },
        "watermark": {
          "oneOf": [
            { "$ref": "#/$defs/timelineAnchor" },
            { "type": "null" }
          ]
        },
        "after": {
          "oneOf": [
            { "$ref": "#/$defs/timelineSnapshotCursor" },
            { "type": "null" }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
