      "type": "object",
      "$comment": "Typed peers verify fixed floor/watermark/totals/active Turn across pages, contiguous ordinals, every Item/page identity, exact cursor chaining, the final complete identity, and an encoded result below the reserved 4 MiB AAP frame budget.",
      "required": [
        "schema_version",
        "session_id",
        "snapshot_identity",
        "floor",
        "watermark",
        "active_turn",
        "total_items",
