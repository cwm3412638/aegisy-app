      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcRequestId" },
        "result": { "$ref": "#/$defs/timelineSyncPage" }
      }
    },
    "timelineSnapshotParams": {
      "type": "object",
